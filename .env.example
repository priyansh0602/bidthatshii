# Environment Variables — copy this file to .env and fill in real values
# DO NOT commit .env — it contains real secrets and is git-ignored

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key — NEVER expose this to the browser.
# Used server-side only in /src/lib/supabaseAdmin.ts (API routes).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ── Admin Dashboard Auth ──────────────────────────────────────────────────────
# Email of the ONE Supabase Auth user allowed to access /admin.
# Create this user in: Supabase Dashboard → Authentication → Users → Add user
ADMIN_EMAIL=admin@yourdomain.com


# ── Dodo Payments ────────────────────────────────────────────────────────────
# Found in: Dodo Payments Dashboard → Developer → API Keys
DODO_API_KEY=your-dodo-api-key-here
# Product ID for bid payments (pay-what-you-want enabled in USD)
DODO_PRODUCT_ID=pdt_0Nnuliu6JfJU3ZJVjXmZW
# 'test' or 'live'
NEXT_PUBLIC_DODO_MODE=test
# Found in: Dodo Payments Dashboard → Developer → Webhooks → Secret
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret-here

